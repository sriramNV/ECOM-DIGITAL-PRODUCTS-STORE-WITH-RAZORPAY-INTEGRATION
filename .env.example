# Required — generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
AUTH_SECRET=

# Database
DATABASE_URL=postgresql://pod:${POSTGRES_PASSWORD}@postgres:5432/digital_products?sslmode=require

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Auth
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=false

# Storage
UPLOAD_DIR=./uploads

# Payment (required for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
