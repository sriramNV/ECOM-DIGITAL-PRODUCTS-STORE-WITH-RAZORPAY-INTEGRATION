# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=generate-a-random-64-char-secret

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Printify
PRINTIFY_API_TOKEN=
