# App
NEXT_PUBLIC_SITE_URL=https://podstore.example.com

# Database
DB_PASSWORD=change-me-to-a-random-password
DATABASE_URL=postgresql://pod:${DB_PASSWORD}@postgres:5432/pod

# Redis
REDIS_URL=redis://redis:6379

# Auth
AUTH_SECRET=generate-a-random-64-char-secret

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Printify
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# MinIO — CHANGE THESE CREDENTIALS before production
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=minio:9000

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Logging
LOG_LEVEL=info
